rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSpaceMember(spaceId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.members;
    }

    // 월별 문서로 옮긴 뒤(표시 flag >= 2)에는 예전 위치 필드를 고치는 쓰기를 막는다.
    //   일기: diaryStorage → diary / sharedDiary,  일정: dayStorage → personalDays / days
    // 업데이트되지 않은 화면이 예전 위치에 써서 조용히 어긋나는 대신 '저장 실패'로 드러나게 하려는 것.
    // 필드를 통째로 지우는 정리는 허용한다.
    function touchesLocked(flag, field) {
      return resource.data.get(flag, 0) >= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        && (field in request.resource.data);
    }

    function isMonthKey(month) {
      return month.matches('^[0-9]{4}-[0-9]{2}$');
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && !touchesLocked('diaryStorage', 'diary')
        && !touchesLocked('dayStorage', 'personalDays');

      // 개인 일기(달마다 문서 하나): 본인만
      match /diaryMonths/{month} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId && isMonthKey(month);
      }

      // 강의 학습: 강좌·강의 내용은 업로드 도구(관리자 권한)만 쓰고, 화면에서는 본인만 읽는다.
      // 저장소가 공개라 강의 내용·정답은 여기에만 둔다.
      match /lectureCourses/{courseId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /lectures/{lectureId} {            // 목록용 정보(제목·장·문항 수)
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /lectureContent/{lectureId} {      // 교육자료 본문·문제은행(무거워서 열 때만 읽음)
        allow get: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      // 시험 진행 상태·셀프 체크·응시 기록: 본인만 읽고 쓴다.
      match /lectureState/{lectureId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /lectureAttempts/{attemptId} {     // 시험지 id 가 문서 id — 재시도해도 같은 기록을 덮어쓴다
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // 개인 일정(달마다 문서 하나): 본인만
      match /dayMonths/{month} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId && isMonthKey(month);
      }
    }

    match /spaces/{spaceId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      allow read: if isSpaceMember(spaceId);

      // 멤버 명단은 callable function만 변경한다. 일반 일정·메모 갱신은 멤버에게 허용한다.
      allow update: if isSpaceMember(spaceId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['members', 'memberProfiles', 'createdAt'])
        && !touchesLocked('diaryStorage', 'sharedDiary')
        && !touchesLocked('dayStorage', 'days');

      allow delete: if false;

      // 교환일기(달마다 문서 하나): 스페이스 멤버만
      match /diaryMonths/{month} {
        allow get, list: if isSpaceMember(spaceId);
        allow write: if isSpaceMember(spaceId) && isMonthKey(month);
      }

      // 공유 일정(달마다 문서 하나): 스페이스 멤버만
      match /dayMonths/{month} {
        allow get, list: if isSpaceMember(spaceId);
        allow write: if isSpaceMember(spaceId) && isMonthKey(month);
      }
    }
  }
}
