VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:you@example.com
# 공공데이터포털 "한국천문연구원_특일 정보" 인증키 (getRestDeInfo)
HOLIDAY_API_KEY=your_data_go_kr_service_key_here
# 구글 캘린더 연동: Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: https://asia-northeast3-minb-spanish-study.cloudfunctions.net/googleCalendarOAuth
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
